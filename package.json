{
  "name": "mc-ai-companion",
  "version": "0.8.0",
  "description": "A Minecraft companion bot: an LLM brain for talking and decisions, plus a fast code-driven body for movement, combat, mining and building.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test",
    "test:sim": "node --test sim/world.sim.js",
